# InferGraph cloudless profile (P0–P4).
# Use with: docker compose -f docker/compose.infergraph-cloudless.yml up
#
# Preferred InferGraph env names (old ROBOFLOW_* still accepted until major):
#   INFERGRAPH_API_KEY, INFERGRAPH_API_HOST, …

PROJECT=infergraph
OFFLINE_MODE=True
USE_INFERENCE_MODELS=True
MODEL_CACHE_DIR=/cache
INFERENCE_HOME=/cache
INFERGRAPH_REGISTRY_ROOT=/cache
METRICS_ENABLED=False
DISABLE_VERSION_CHECK=True
ACTIVE_LEARNING_ENABLED=False
WORKFLOWS_STEP_EXECUTION_MODE=local

# Point both Inference API clients at InferGraph Registry (must match).
API_BASE_URL=http://inferegistry:8000
API_PROXY_BASE_URL=http://inferegistry:8000
INFERGRAPH_API_HOST=http://inferegistry:8000
# Deprecated alias — same Registry host (remove in a future major):
ROBOFLOW_API_HOST=http://inferegistry:8000
INFERGRAPH_REGISTRY_ALLOWLIST=inferegistry:8000,127.0.0.1:8000

# Default-disable Roboflow cloud sink / monitoring blocks (P2).
WORKFLOW_DISABLED_BLOCK_PATTERNS=roboflow.dataset_upload,model_monitoring_inference_aggregator,roboflow.custom_metadata,roboflow.vision_events,asset_library_attributes,visual_search

# InferGraph Build (P3): same-origin SPA at /workflows/local
ENABLE_BUILDER=True
BUILDER_ORIGIN=http://127.0.0.1:9001
HOST=0.0.0.0
PORT=9001
NUM_WORKERS=1

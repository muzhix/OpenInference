# InferGraph cloudless profile (P0).
# Use with: docker compose -f docker/compose.infergraph-cloudless.yml up
# Do not point defaults at *.roboflow.com — placeholder ports fail closed.

OFFLINE_MODE=True
USE_INFERENCE_MODELS=True
MODEL_CACHE_DIR=/cache
INFERENCE_HOME=/cache
METRICS_ENABLED=False
DISABLE_VERSION_CHECK=True
ACTIVE_LEARNING_ENABLED=False
WORKFLOWS_STEP_EXECUTION_MODE=local
API_BASE_URL=http://127.0.0.1:9
API_PROXY_BASE_URL=http://127.0.0.1:9
ROBOFLOW_API_HOST=http://127.0.0.1:9
BUILDER_ORIGIN=http://127.0.0.1:9001
HOST=0.0.0.0
PORT=9001
NUM_WORKERS=1
PROJECT=roboflow-platform
ENABLE_BUILDER=False

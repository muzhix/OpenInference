# InferGraph cloudless profile for local runs (P0–P4).
# Example: set -a && source env.infergraph && set +a
#
# Preferred InferGraph env names (old ROBOFLOW_* still accepted until major):
#   INFERGRAPH_API_KEY, INFERGRAPH_API_HOST, INFERGRAPH_API_EXTRA_HEADERS, …

PROJECT=infergraph
OFFLINE_MODE=True
USE_INFERENCE_MODELS=True
MODEL_CACHE_DIR=./infergraph-cache
INFERENCE_HOME=./infergraph-cache
INFERGRAPH_REGISTRY_ROOT=./infergraph-cache
METRICS_ENABLED=False
DISABLE_VERSION_CHECK=True
ACTIVE_LEARNING_ENABLED=False
WORKFLOWS_STEP_EXECUTION_MODE=local

API_BASE_URL=http://127.0.0.1:8000
API_PROXY_BASE_URL=http://127.0.0.1:8000
INFERGRAPH_API_HOST=http://127.0.0.1:8000
# Deprecated alias — same Registry host (remove in a future major):
ROBOFLOW_API_HOST=http://127.0.0.1:8000
INFERGRAPH_REGISTRY_ALLOWLIST=127.0.0.1:8000
# Optional: blank to omit VISIT help URLs in inference_models errors
# INFERGRAPH_ERRORS_DOCS_BASE=

# Default-disable Roboflow cloud sink / monitoring blocks (P2).
WORKFLOW_DISABLED_BLOCK_PATTERNS=roboflow.dataset_upload,model_monitoring_inference_aggregator,roboflow.custom_metadata,roboflow.vision_events,asset_library_attributes,visual_search

# InferGraph Build (P3): iframe loads same-origin /workflows/local SPA.
ENABLE_BUILDER=True
BUILDER_ORIGIN=http://127.0.0.1:9001
HOST=0.0.0.0
PORT=9001
NUM_WORKERS=1
